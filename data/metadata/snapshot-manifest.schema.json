{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pixawesome01/AusMammal-Explorer/data/metadata/snapshot-manifest.schema.json",
  "title": "AusMammal Explorer frozen snapshot manifest",
  "description": "Describes one frozen, versioned ALA data snapshot: its source, coverage, output files with checksums, and licence/attribution metadata. See snapshot-manifest.example.json for a filled-in instance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "captured_at",
    "source",
    "query",
    "coverage",
    "files",
    "licence_and_attribution",
    "transformation_provenance",
    "pipeline_version",
    "notes"
  ],
  "properties": {
    "snapshot_id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$",
      "description": "Dated, human-readable snapshot identifier, e.g. 2026-08-11-ala-marsupials."
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp the snapshot was extracted, e.g. 2026-08-11T09:15:00Z."
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "query": {
      "type": "object",
      "description": "Parameters used to extract the snapshot (taxa, fields, filters, data profile, etc.)."
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "format": "date" },
        "to": { "type": "string", "format": "date" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "record_count"],
        "properties": {
          "path": {
            "type": "string",
            "description": "Path relative to the repository root."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "record_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "licence_and_attribution": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["licence", "attribution"],
        "properties": {
          "licence": { "type": "string", "minLength": 1 },
          "attribution": { "type": "string", "minLength": 1 },
          "source_record_count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "transformation_provenance": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered cleaning/transformation steps applied to produce this snapshot's outputs, each with the record count before and after.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "records_before", "records_after", "records_dropped"],
        "properties": {
          "step": { "type": "string", "minLength": 1 },
          "records_before": { "type": "integer", "minimum": 0 },
          "records_after": { "type": "integer", "minimum": 0 },
          "records_dropped": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "pipeline_version": {
      "type": "string",
      "minLength": 1,
      "description": "Git commit sha of the pipeline code that produced this snapshot, or \"unknown\"."
    },
    "notes": {
      "type": "string"
    }
  }
}
